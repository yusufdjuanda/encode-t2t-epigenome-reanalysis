MAPPING_STATS = f"{COMPARISON_DIR}/mapping_stats.tsv"
PAPER_COMPARISON = f"{COMPARISON_DIR}/paper_comparison.tsv"


wildcard_constraints:
    library=r"[A-Za-z0-9_-]+",
    replicate=r"[A-Za-z0-9_-]+",
    experiment=r"[A-Za-z0-9_-]+",
    step="|".join(STEP_BAMS),
    k="|".join(str(k) for k in KMER_SIZES),
    peak_type="narrow|broad",


