configfile: "config/config.yaml"

RESULTS = config["paths"]["results"]
LOGS = config["paths"]["logs"]
BENCHMARKS = config["paths"]["benchmarks"]
DATA = config["paths"]["data"]
ACCESSIONS = config["accessions"]["pilot_file"]
ASSAY_TITLE = config["accessions"]["assay_title"]
CONTROL_STRATEGY = config["accessions"]["control_strategy"]
REFERENCES = config["paths"]["references"]
REFERENCE_NAME = config["reference"]["name"]
REFERENCE_FASTA = config["reference"]["fasta"]
REFERENCE_INDEX_PREFIX = config["reference"]["bowtie2_index_prefix"]
SCRIPTS_DIR = Path(workflow.basedir) / "scripts"
FASTQ_MANIFEST = f"{DATA}/fastq/manifest.tsv"
FASTQ_METADATA = f"{DATA}/fastq/metadata.jsonl"
# ENCODEfetch names the samplesheet after the assay, e.g. "TF ChIP-seq" ->
# snakemake_tf_chip-seq_samplesheet.csv.
FASTQ_SAMPLESHEET = (
    f"{DATA}/fastq/snakemake_{ASSAY_TITLE.lower().replace(' ', '_')}_samplesheet.csv"
)
FASTQ_VERIFIED = f"{DATA}/fastq/download.verified"
ALIGNMENT_DIR = f"{RESULTS}/alignment/{REFERENCE_NAME}"
ALIGNMENT_MANIFEST = f"{ALIGNMENT_DIR}/alignment_manifest.tsv"
REPLICATE_MANIFEST = f"{ALIGNMENT_DIR}/replicate_manifest.tsv"
ALIGNED_BAM = f"{ALIGNMENT_DIR}/{{library}}.sorted.bam"
REPLICATE_BAM = f"{ALIGNMENT_DIR}/replicates/{{replicate}}.sorted.bam"

# Step 03: read filter and duplicate removal, per replicate.
FILTER_DIR = f"{RESULTS}/filtering/{REFERENCE_NAME}"
FILTERED_BAM = f"{FILTER_DIR}/filtered/{{replicate}}.bam"
DEDUP_BAM = f"{FILTER_DIR}/dedup/{{replicate}}.bam"
# Step 04: unique-k-mer filter, per replicate.
KMER_BAM = f"{FILTER_DIR}/kmer/{{replicate}}.bam"
FLAGSTAT = f"{FILTER_DIR}/flagstat/{{step}}/{{replicate}}.json"
# The BAM each flagstat step counts: mapped, filtered, dedup and kmer, as in
# the authors' mapping_stats.txt.
STEP_BAMS = {
    "mapped": REPLICATE_BAM,
    "filtered": FILTERED_BAM,
    "dedup": DEDUP_BAM,
    "kmer": KMER_BAM,
}

# Unique-k-mer tracks depend only on the reference, so they live outside the
# per-mode results and are shared by every run on that reference.
KMER_SETTINGS = config["kmer_filter"]
KMER_SIZES = [int(k) for k in KMER_SETTINGS["sizes"]]
TOOLS_DIR = f"{REFERENCES}/tools"
KMC_DIR = f"{TOOLS_DIR}/KMC-{KMER_SETTINGS['kmc_commit']}"
KMC_BIN = f"{KMC_DIR}/kmc"
KMC_GENOME_COUNTS = f"{KMC_DIR}/kmc_genome_counts"
WIGTOBIGWIG = f"{TOOLS_DIR}/wigToBigWig"
KMER_DIR = f"{REFERENCES}/{REFERENCE_NAME}/kmer"
KMER_FASTA = f"{KMER_DIR}/{REFERENCE_NAME}.kmer_chromosomes.fa"
KMER_DB = f"{KMER_DIR}/kmc/{REFERENCE_NAME}_k{{k}}"
KMER_TRACK = f"{KMER_DIR}/{REFERENCE_NAME}.k{{k}}.unique_kmer_counts.bw"

# Step 05: replicates pooled per experiment, peaks against the pooled control.
PEAKS_DIR = f"{RESULTS}/peaks/{REFERENCE_NAME}"
POOLED_BAM = f"{PEAKS_DIR}/pooled/{{experiment}}.bam"
PEAKS = f"{PEAKS_DIR}/macs3/{{experiment}}_peaks.{{peak_type}}Peak"

# Step 06: comparison with the authors' results.
